{
  "manifest_version": 3,
  "name": "Product Grabber (TikTok Shop VN)",
  "version": "0.1.0",
  "description": "Lấy tên, giá, ảnh gốc, video và mô tả từ trang sản phẩm TikTok Shop đang mở.",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": [
    "https://shop.tiktok.com/*",
    "https://www.tiktok.com/*",
    "https://*.ibyteimg.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.ttcdn-us.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lấy thông tin sản phẩm"
  }
}
